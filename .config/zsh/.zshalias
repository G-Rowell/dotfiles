function msx() {
  ms sh -c "$*";
}
alias msd='msx "pnpm install && pnpm dev"'
# podman pull ghcr.io/pnpm/pnpm:12
# podman pull docker.io/node
#alias pnpm='podman run -it --memory=8g --memory-swap=10g --workdir /home/node/ --rm=true --volume=./:/home/node/ --network=host pnpm:12 '
alias mst='msx "pnpm install && pnpm typecheck"'
alias mstest='msx "pnpm install && pnpm test"'
alias msgrep="grep -ri --exclude-dir={'node_modules','.git','dist','_backend','_frontend','.*'} --exclude={'yarn.lock','yarn-error.log','.*','vite.config.ts.*','tsconfig*'}"
# podman pull docker.io/mongodb/atlas

# FLL score calculator repo container
function fll() {
  [[ $# -eq 0 ]] && set -- bash
  podman run -it \
    --rm=true \
    --memory=4g \
    --memory-swap=6g \
    --network=host \
    --volume "$PWD":/app \
    --volume fll-corepack:/corepack \
    --env COREPACK_HOME=/corepack \
    --env COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    --env pnpm_config_store_dir=/app/.pnpm-store \
    --workdir /app \
    docker.io/library/node:22 \
    sh -c 'corepack enable && exec "$@"' sh "$@"
}

# DigitalOcean CLI container
# podman pull docker.io/digitalocean/doctl
function doctl() {
  podman run -it \
    --rm=true \
    --network=host \
    --volume doctl-config:/root/.config/doctl \
    --volume "$PWD":/workdir \
    --workdir /workdir \
    --entrypoint /app/doctl \
    --secret do_token,type=env,target=DIGITALOCEAN_ACCESS_TOKEN \
    docker.io/digitalocean/doctl:latest \
    "$@"
}

alias mongodb='podman run -it --memory=8g --memory-swap=10g --rm=true --network=host --volume=./:/home/ mongodb/atlas /bin/bash'

# podman pull docker.io/heroku/heroku
#alias heroku='podman run -it --workdir /home/ --rm=true --volume=./:/home/ --network=host heroku/heroku:26 /bin/bash'
alias heroku="podman run -it --rm node:22 sh -c 'echo \"starting container\";command -v heroku >/dev/null || npm i -g --prefix /root/.npm-global heroku --silent; exec bash \"\$@\"' --"


alias cse='ssh -XY z5214822@cse.unsw.edu.au'
alias hsk='podman run -it --memory=8g --memory-swap=10g --workdir /home/ --rm=true --volume=./:/home/ --network=host haskell /bin/bash'

alias v=nvim

#alias steam='flatpak run com.valvesoftware.Steam'

# Some `ls` aliases
alias ls='ls -1 --color --group-directories-first'
alias ll='ls -lhA --color --group-directories-first'

# Some `cd` aliases
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'

# Some `git` aliases
alias ga='git add'
alias gs='git status; echo; git show -q'
## Git status status, what is ahead & behind for branches
alias gss='git for-each-ref --sort=-committerdate refs/heads/ --count=50 \
  --format="%(refname:short)|%(upstream:short)|%(upstream:track)" \
| column -t -s "|"'
alias gc='git commit'
alias gch='git checkout'
alias gpul='git pull'
alias gp='git push'
alias gf='git fetch --all; git status'
alias gb='git branch'

alias grem='git remote -v'

alias gr='git reset'
alias grh='gr --hard'
alias grs='gr --soft'

alias grb='git rebase'
alias grbi='grb --interactive'
alias grbc='grb --continue'
alias grbs='grb --skip'
alias grba='grb --abort'

alias gd='git diff'
alias glog='git log --oneline'
